          ""
        ],
        [
          "T₁, T₂",
          "প্রাথমিক ও চূড়ান্ত তাপমাত্রা",
          ""
        ],
        [
          "n",
          "মোল সংখ্যা, n = w/M = নির্দিষ্ট গ্যাসের ভর / আণবিক ভর",
          ""
        ],
        [
          "d₁, d₂",
          "প্রাথমিক ও চূড়ান্ত ঘনত্ব",
          ""
        ]
      ],
      "topic": "আদর্শ গ্যাস সমীকরণ"
    },
