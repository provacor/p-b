    {
      "id": "physics_1st_ch10_formula_0001",
      "kind": null,
      "title": "গ্যাসের সূত্রাবলি",
      "formulas": [
        "বয়েলের সূত্র: P₁V₁ = P₂V₂ [যখন, T স্থির]",
        "চার্লসের সূত্র: V₁/T₁ = V₂/T₂ [যখন, P স্থির]",
        "চাপীয় সূত্র (গে-লুসাকের সূত্র): P₁/T₁ = P₂/T₂ [যখন, V স্থির]",
        "আদর্শ গ্যাস সমীকরণ: PV = nRT",
        "সমন্বিত সূত্র: P₁V₁/T₁ = P₂V₂/T₂",
        "সমন্বিত সূত্র (ঘনত্বসহ): P₁/(d₁T₁) = P₂/(d₂T₂)"
      ],
      "symbols": [
