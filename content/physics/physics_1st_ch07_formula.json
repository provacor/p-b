    {
      "id": "physics_1st_ch07_formula_0001",
      "kind": null,
      "title": "বিকৃতি ও পীড়ন",
      "formulas": [
        "দৈর্ঘ্য বিকৃতি = l/L",
        "দৈর্ঘ্য পীড়ন = F/A = mg/πr²",
        "আয়তন বিকৃতি = v/V",
        "আয়তন পীড়ন = F/A",
        "ব্যবর্তন বিকৃতি = θ (রেডিয়ান) = tanθ = CC′/CD",
        "ব্যবর্তন পীড়ন = F/A"
      ],
      "symbols": [
