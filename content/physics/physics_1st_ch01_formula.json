      "formulas": [
        "A = (x₁ + x₂ + x₃ + … + xₙ)/n",
        "d₁ = |x₁ − A|, d₂ = |x₂ − A|, …, dₙ = |xₙ − A|",
        "d = (d₁ + d₂ + d₃ + … + dₙ)/n",
        "x = A ± d",
        "δx = d/A",
        "σ = √((d₁² + d₂² + d₃² + … + dₙ²)/n)",
        "% e = (সঠিক মান ~ পরিমাপকৃত মান)/সঠিক মান × 100%",
        "Z = A + B হলে, ΔZ/Z = ΔA/A + ΔB/B",
