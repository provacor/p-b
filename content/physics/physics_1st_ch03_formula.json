    {
      "id": "physics_1st_ch03_formula_0006",
      "kind": null,
      "title": "আনুভূমিক প্রাস",
      "formulas": [
        "vₓ = vₓ₀ = v₀; x = v₀t",
        "v_y₀ = 0; v_y = gt; y = ½gt²; v_y² = 2gy",
        "আদর্শ সমীকরণ, y = (g/(2v₀²))x²"
      ],
