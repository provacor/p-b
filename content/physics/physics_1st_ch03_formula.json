    {
      "id": "physics_1st_ch03_formula_0001",
      "kind": null,
      "title": "সুষম ত্বরণে গতিশীল বস্তুর সমীকরণ",
      "formulas": [
        "v = v₀ + at ⇒ a = (v − v₀)/t",
        "s = v₀t + ½at²",
        "v² = v₀² + 2as",
        "t-তম সময়ে অতিক্রান্ত দূরত্ব, s_tth = v₀ + ½a(2t − 1)",
        "গড় বেগের মাধ্যমে সরণ, s = v̄t = ((v₀ + v)/2)t"
      ],
      "symbols": [
        [
          "v₀",
          "আদিবেগ",
          ""
        ],
        [
          "v",
          "শেষ বেগ",
          ""
        ],
        [
          "a",
          "ত্বরণ",
          ""
        ],
        [
          "s",
          "সরণ",
          ""
        ],
        [
          "t",
          "সময়",
          ""
        ]
      ],
      "note": "সমবেগে গতিশীল বস্তুর ত্বরণ, a = 0 তাই সরণ, s = vt"
    },
    {
      "id": "physics_1st_ch03_formula_0002",
      "kind": null,
      "title": "উপরের দিকে নিক্ষিপ্ত বস্তু",
      "formulas": [
        "v = v₀ − gt",
        "h = v₀t − ½gt²",
        "v² = v₀² − 2gh",
        "সর্বোচ্চ উচ্চতা, H = v₀²/(2g)",
        "উড্ডয়ন কাল, T = 2v₀/g",
        "সর্বোচ্চ উচ্চতায় ওঠার সময়, t_H = v₀/g"
      ],
      "symbols": [
