    {
      "id": "physics_1st_ch03_formula_0003",
      "kind": null,
      "title": "নির্দিষ্ট উচ্চতা থেকে উপরের/নিচের দিকে নিক্ষিপ্ত বস্তু",
      "formulas": [
        "উপরের দিকে: v = −v₀ + gt; h = −v₀t + ½gt²; v² = v₀² + 2gh",
        "নিচের দিকে: v = v₀ − gt; h = v₀t + ½gt²; v² = v₀² − 2gh"
      ],
      "symbols": [
        [
          "h",
          "নির্দিষ্ট উচ্চতা",
          ""
        ]
      ]
    },
    {
      "id": "physics_1st_ch03_formula_0004",
      "kind": null,
      "title": "ভূমি হতে নিক্ষিপ্ত প্রাস",
      "formulas": [
        "vₓ₀ = v₀cosθ₀; v_y₀ = v₀sinθ₀; v = √(vₓ² + v_y²); θ = tan⁻¹(v_y/vₓ)",
        "x = (v₀cosθ₀)t; y = (v₀sinθ₀)t − ½gt²",
        "v_y = v₀sinθ₀ − gt; v_y² = (v₀sinθ₀)² − 2gy",
        "সর্বোচ্চ উচ্চতা, H = v₀²sin²θ₀/(2g)",
        "অনুভূমিক পাল্লা, R = v₀²sin2θ₀/g",
        "বিচরণকাল, T = 2v₀sinθ₀/g",
        "সর্বোচ্চ উচ্চতায় ওঠার সময়, t_H = v₀sinθ₀/g",
        "সর্বোচ্চ পাল্লা, R_max = v₀²/g",
        "আদর্শ সমীকরণ, y = (tanθ₀)x − gx²/(2(v₀cosθ₀)²)"
      ],
      "symbols": [
        [
          "v₀",
          "নিক্ষেপ বেগ",
          ""
        ],
        [
          "θ₀",
          "নিক্ষেপ কোণ",
          ""
        ],
        [
          "R",
          "পাল্লা",
          ""
        ]
      ]
    },
    {
      "id": "physics_1st_ch03_formula_0005",
      "kind": null,
      "title": "নির্দিষ্ট উচ্চতা হতে নিক্ষিপ্ত প্রাস",
      "formulas": [
        "vₓ = vₓ₀; x = (v₀cosθ₀)t",
        "v_y = v₀sinθ₀ − gt",
        "−y = (v₀sinθ₀)t − ½gt²; v_y² = (v₀sinθ₀)² + 2gy",
        "আদর্শ সমীকরণ, y = −(tanθ₀)x + gx²/(2(v₀cosθ₀)²)"
      ],
      "symbols": [
        [
          "y",
          "ভূমি বরাবর নিচের উচ্চতা",
