   "title": "তাপমাত্রা রূপান্তর",
   "formulas": [
    "C/5 = (F − 32)/9 = (K − 273)/5",
    "F = 9*C/5 + 32",
    "C = 5*(F − 32)/9",
    "K = C + 273"
   ],
   "symbols": [
